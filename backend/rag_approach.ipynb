import streamlit as st

st.title("Real Estate Assistant")
st.sidebar.header("Preferences")

# User Input
region = st.sidebar.selectbox("Select Region", ["Riyadh", "Jeddah", "Dammam"])
price = st.sidebar.slider("Select Price Range", 500000, 3000000, 1500000)

if st.button("Search"):
    # Pass input to Conversation Agent
    user_input = {"Region": region, "sakani_price": price}
    st.session_state['filters'] = user_input
    st.write("Searching for properties...")

class ConversationAgent:
    def parse_user_input(self, user_input):
        # Extract preferences
        preferences = {
            "Region": user_input.get("Region"),
            "sakani_price": user_input.get("sakani_price")
        }
        return preferences

    def respond(self, preferences):
        return f"Searching for properties in {preferences['Region']} under {preferences['sakani_price']} Riyals."
